    "id": "the_empty_stand",
    "name": "The Empty Stand",
    "summary": "The king is dead and the Crown is gone. Osbric wants a stranger with fresh eyes.",
    "level": 1,
    "after": [],
    "steps": [
      {
        "npc": "tam",
        "todo": "Ask Tam what he saw. He wants three moss imps driven off the road first.",
        "say": [
          "The harness is safe again. Thank you."
