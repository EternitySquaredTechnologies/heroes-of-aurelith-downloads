  {
    "id": "the_empty_stand",
    "name": "The Empty Stand",
    "summary": "The king is dead and the Crown is gone. Osbric wants a stranger with fresh eyes.",
    "level": 1,
    "after": [],
    "steps": [
      {
        "npc": "tam",
        "todo": "Ask Tam what he saw. He wants three moss imps driven off the road first.",
        "say": [
          "The harness is safe again. Thank you."
        ],
        "waiting": [
          "I will tell you what I saw. But the imps keep chewing the harness. Drive off three, outside the wall, and I will tell you everything. They are south of the gate, among the trees."
        ],
        "need": {
          "type": "kill",
          "monster": "moss_imp",
          "count": 3
        }
      },
      {
        "npc": "tam",
        "todo": "Hear what Tam saw.",
        "say": [
          "A tall man in a pale mask walked out by the west gate on the night of the Harvest Watch. He did not walk like a man. He walked like water poured out of a jug.",
          "Tell the Warden. Tell him I did not take the mare."
        ],
        "need": {
          "type": "none"
        }
      },
      {
        "npc": "osbric",
        "todo": "Tell Osbric about the masked man.",
        "say": [
          "The west gate. Of course. They went the long way round, so no guard would see.",
          "You have done more in an afternoon than my whole watch did in eleven days. Take this. It is not much, but you will need the tools."
        ],
        "need": {
          "type": "none"
        }
      }
    ],
    "reward": {
      "xp": 120,
      "iron_bits": 40,
      "gold_coins": 0,
      "favor_tokens": 1,
      "items": [
        {
          "item": "bronze_axe",
          "qty": 1
        },
        {
          "item": "bronze_pickaxe",
          "qty": 1
        },
        {
          "item": "reed_rod",
          "qty": 1
        },
        {
          "item": "rope_snare",
          "qty": 1
        }
      ]
    },
    "done": [
      "Osbric looks at the west gate for a long time, then back at you.",
      "\"Good work, Wanderer. Come back when you have more of the Reach in your boots.\""
    ],
    "giver": "osbric",
    "offer": [
      "The Crown lay on a stand in the Tower. Look at it if you like; the guard on the door will let you stand outside, no further.",
      "Before that, go to the stable and talk to Tam. He saw something that night and he is too frightened to say what.",
      "Be kind to him. He is twelve and thinks he is in trouble."
    ]
  },
