    "talk": [
      {
        "label": "What is the Delve?",
        "lines": [
          "The mine under the hill, the Black Sump. It flooded eleven weeks ago, in the night. The second shift was below. We have not heard from them since.",
          "The man who ran that shift was my brother. I would like to know what happened to him before anyone else tells me."
        ]
      },
      {
        "label": "Who was the last foreman?",
        "lines": [
          "I am the only foreman Dunhollow has. Ask me again when the Delve is quiet."
        ]
      }
    ],
    "services": [
      {
        "kind": "quests"
      }
    ]
  },
  {
    "id": "peg",
    "name": "Peg Anvil",
    "role": "Ore buyer",
    "look": {
      "g": "f",
      "skin": 1,
      "hair": "#8a5a2a",
      "cloth": "#6a4a3a",
      "accent": "#c88a3c",
      "hat": "none"
    },
    "greeting": [
      "I buy ore at fair weight and sell picks at a fair price. Do not weigh your thumb."
    ],
    "talk": [
      {
        "label": "Any trouble?",
        "lines": [
          "Rats. They come up out of the Delve through the drains and eat the sacks. I would pay for the lot of them."
        ]
      }
    ],
    "services": [
      {
        "kind": "shop",
        "shop": "ore_store"
      },
      {
        "kind": "quests"
      }
    ]
  },
  {
    "id": "brannoch",
    "name": "Brannoch Stoke",
    "role": "Smith",
    "look": {
      "g": "m",
      "skin": 3,
      "hair": "#1a1210",
      "cloth": "#6a4a3a",
      "accent": "#d86a3c",
      "hat": "none"
    },
    "greeting": [
      "The furnace is lit. Anvil is free. Do not stand there and talk."
    ],
    "talk": [
      {
        "label": "How do I smelt iron?",
        "lines": [
          "One ore, one bar, at the furnace. Smithing level 10. Then bars go to the anvil for blades and daggers. Coal and iron together make steel, at level 20."
        ]
      }
    ],
    "services": [
      {
        "kind": "shop",
        "shop": "dunhollow_smithy"
      },
      {
        "kind": "quests"
      }
