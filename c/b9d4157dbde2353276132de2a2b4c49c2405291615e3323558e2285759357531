      "hat": "hood"
    },
    "greeting": [
      "Keep your voice down. The warren is right there."
    ],
    "talk": [
      {
        "label": "What is in the warren?",
        "lines": [
          "Goblins, a lot of them. Pinegrubs up front, nutcrackers behind them with the big clubs. They eat pine nuts all day and they are never short of any."
        ]
      },
      {
        "label": "Who leads them?",
        "lines": [
          "The Mind Goblin. Big as a cart, ugly as a boiled boot, and he throws pine nuts at you from across the room. It sounds funny until the third one lands.",
          "Go in with food and a full bag. You cannot run from him once the fight starts."
        ]
      }
    ],
    "services": [
      {
        "kind": "quests"
      }
    ]
