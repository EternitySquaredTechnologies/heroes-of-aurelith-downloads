[
  {
    "id": "osbric",
    "name": "Warden Osbric Greyhelm",
    "role": "Captain of the royal guard",
    "look": {
      "g": "m",
      "skin": 1,
      "hair": "#8a8a92",
      "cloth": "#4a5a7a",
      "accent": "#c8a050",
      "hat": "helm"
    },
    "greeting": [
      "Another stranger. Good. The ones I know are all dead or under suspicion.",
      "Stay out of the Tower after dark and we will get along."
    ],
    "talk": [
      {
        "label": "What happened here?",
        "lines": [
          "The king is dead. Poisoned, then stabbed, in his own tower, eleven days ago. The Crown was lifted from its stand.",
          "We found a white mask on the floor with its eyeholes sealed. Make of that what you like. I have made nothing of it yet."
        ]
      },
      {
        "label": "Who are you?",
        "lines": [
          "Osbric. I commanded the guard for thirty years. I still do, for the few I trust.",
          "I do not have many. That is why I am speaking to you."
        ]
      }
    ],
    "services": [
      {
        "kind": "quests"
      }
    ]
  },
  {
